# SIYI UniFC 6 Pico (ArduRover 4.7.0) as UGV-01 flight controller, replacing the Matek H743-WING.
# Applied on top of the board's current values (factory Rover defaults); anything not listed stays.
# Same behaviour as the Matek setup of 2026-10-28 (matek-ugv-01-20261028-new-setup.param).
# Loadable in Mission Planner.
#
# Outputs: Rover factory default, so the RCU-ND cables go on output 1 (steering) and 3 (throttle)
SERVO1_FUNCTION,26
SERVO3_FUNCTION,70
#
# Stick ranges measured from the SIYI UniRC 7 Pro (1050-1950)
RC1_MIN,1050
RC1_MAX,1950
RC1_TRIM,1500
RC3_MIN,1050
RC3_MAX,1950
RC3_TRIM,1500
#
# Arm / disarm on ch12
RC12_OPTION,153
#
# Mode switch on ch10: low = HOLD, middle and high = MANUAL
MODE_CH,10
MODE1,4
MODE2,4
MODE3,0
MODE4,0
MODE5,0
MODE6,0
#
# Failsafes: remote lost -> HOLD after 1.5 s, gateway lost -> HOLD
FS_THR_ENABLE,1
FS_ACTION,2
FS_GCS_ENABLE,1
#
# Console driving: RC overrides expire 1 s after the gateway stops sending
RC_OVERRIDE_TIME,1
#
# TELEM1 to the SIYI air unit (Datalink 1), 57600 like the remote today; only TX/RX/GND wired
SERIAL1_PROTOCOL,2
SERIAL1_BAUD,57
BRD_SER1_RTSCTS,0
# Keep UniGCS from overwriting TELEM1 stream rates (the gateway still uses SET_MESSAGE_INTERVAL)
MAV2_OPTIONS,4
#
# No hardware safety button on this vehicle (the board defaults to needing one)
BRD_SAFETY_DEFLT,0
#
# Compasses off until calibrated outdoors (as on the Matek)
COMPASS_USE,0
COMPASS_USE2,0
COMPASS_USE3,0
#
# PWM signal stays 3.3 V (the RCU-ND worked with the Matek's 3.3 V).
# If the RCU-ND ignores the UniFC's signal, set BRD_PWM_VOLT_SEL to 1 (5 V) and reboot.

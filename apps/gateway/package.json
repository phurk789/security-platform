{
  "name": "@13store/gateway",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Edge Gateway: runs device adapters on site and connects them to the platform server",
  "main": "./src/index.ts",
  "scripts": {
    "start": "tsx src/cli.ts",
    "dev": "tsx src/cli.ts",
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/index.js --external:ws",
    "start:prod": "node dist/index.js"
  },
  "dependencies": {
    "@13store/shared": "*",
    "jpeg-js": "^0.4.4",
    "node-mavlink": "^2.3.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15"
  }
}

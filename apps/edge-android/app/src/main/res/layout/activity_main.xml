<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/title"
                    style="@style/Edge.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name" />

                <TextView
                    android:id="@+id/subtitle"
                    style="@style/Edge.Muted"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <Button
                android:id="@+id/langButton"
                style="@style/Edge.SmallButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/switch_language" />
        </LinearLayout>

        <!-- A newer version on the paired server, or an update in progress -->
        <LinearLayout
            android:id="@+id/updateBanner"
            style="@style/Edge.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/updateBannerText"
                style="@style/Edge.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textStyle="bold" />

            <Button
                android:id="@+id/updateBannerButton"
                style="@style/Edge.SmallButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp" />
        </LinearLayout>

        <!-- Not paired: pair with a code from Admin → Pair an edge remote -->
        <LinearLayout
            android:id="@+id/pairSection"
            style="@style/Edge.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Edge.Heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pair_title" />

            <TextView
                style="@style/Edge.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pair_help" />

            <EditText
                android:id="@+id/serverInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/server_hint"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:textSize="20sp" />

            <EditText
                android:id="@+id/codeInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/code_hint"
                android:importantForAutofill="no"
                android:inputType="number"
                android:letterSpacing="0.2"
                android:maxLength="7"
                android:textSize="32sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/pairButton"
                    style="@style/Edge.BigButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:backgroundTint="@color/primary"
                    android:text="@string/pair_button" />

                <Button
                    android:id="@+id/scanButton"
                    style="@style/Edge.BigButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/idle"
                    android:text="@string/scan_button" />
            </LinearLayout>

            <TextView
                android:id="@+id/pairMessage"
                style="@style/Edge.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Paired: start / stop and what the gateway is doing -->
        <LinearLayout
            android:id="@+id/runSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                style="@style/Edge.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/phaseText"
                    style="@style/Edge.Heading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/problemText"
                    style="@style/Edge.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/bad" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/startButton"
                        style="@style/Edge.BigButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:backgroundTint="@color/ok"
                        android:text="@string/start" />

                    <Button
                        android:id="@+id/stopButton"
                        style="@style/Edge.BigButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/bad"
                        android:text="@string/stop" />
                </LinearLayout>

                <TextView
                    style="@style/Edge.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/datalink_warning"
                    android:textColor="@color/warn" />
            </LinearLayout>

            <LinearLayout
                style="@style/Edge.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Edge.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_server" />

                <TextView
                    android:id="@+id/serverStatus"
                    style="@style/Edge.Status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    style="@style/Edge.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/section_vehicles" />

                <TextView
                    android:id="@+id/devicesStatus"
                    style="@style/Edge.Status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    style="@style/Edge.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/section_video" />

                <TextView
                    android:id="@+id/videoStatus"
                    style="@style/Edge.Status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                style="@style/Edge.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Edge.Label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/section_log" />

                    <Button
                        android:id="@+id/logMore"
                        style="@style/Edge.SmallButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/log_more" />
                </LinearLayout>

                <TextView
                    android:id="@+id/logView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="@color/text"
                    android:textIsSelectable="true"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Settings -->
        <LinearLayout
            style="@style/Edge.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Edge.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings" />

            <Switch
                android:id="@+id/bootSwitch"
                style="@style/Edge.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/boot_switch" />

            <TextView
                style="@style/Edge.Muted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/boot_help" />

            <TextView
                android:id="@+id/batteryText"
                style="@style/Edge.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />

            <Button
                android:id="@+id/batteryButton"
                style="@style/Edge.SmallButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/battery_button" />

            <TextView
                style="@style/Edge.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/update_title" />

            <TextView
                android:id="@+id/updateText"
                style="@style/Edge.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/checkUpdateButton"
                    style="@style/Edge.SmallButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/update_check" />

                <Button
                    android:id="@+id/installUpdateButton"
                    style="@style/Edge.SmallButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/unpairButton"
                    style="@style/Edge.SmallButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/unpair" />

                <Button
                    android:id="@+id/licensesButton"
                    style="@style/Edge.SmallButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/licenses" />
            </LinearLayout>

            <TextView
                android:id="@+id/versionText"
                style="@style/Edge.Muted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
